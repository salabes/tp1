                        <Image url="@/org/ajedrez/imagenes/jugar_salir.png" />
                    </image>
                </ImageView>
                <Button layoutX="84.0" layoutY="270.0" mnemonicParsing="false" onAction="#abrirVentanaUsuarios" prefHeight="30.0" prefWidth="122.0" text="Jugar" />
