<?import javafx.scene.text.Font?>

<VBox prefHeight="278.0" prefWidth="451.0" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ajedrez.controller.VentanaController">
    <children>
        <AnchorPane maxHeight="-1.0" maxWidth="-1.0" prefHeight="303.0" prefWidth="474.0" style="-fx-border-color: Black; -fx-border-width: 10;" VBox.vgrow="ALWAYS">
            <children>
                <ImageView fitHeight="312.0" fitWidth="473.0" layoutX="20.0" layoutY="17.0" pickOnBounds="true" preserveRatio="true">
